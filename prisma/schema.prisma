// Empire — Prisma schema (Phase 1 auth + Phase 2 journal/calendar/analytics/
// charts/watchlists/alerts/notifications)
// Postgres via Supabase. Pooled URL (connection_limit≈10, generous
// pool_timeout) for `url`, direct URL for migrations (bug #7).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String               @id @default(cuid())
  email              String               @unique
  emailVerifiedAt    DateTime?
  passwordHash       String? // null for OAuth-only accounts
  displayName        String
  role               Role                 @default(USER)
  imageUrl           String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  sessions           Session[]
  oauthAccounts      OAuthAccount[]
  verificationTokens VerificationToken[]
  passwordResets     PasswordResetToken[]
  journals           Journal[]
  trades             Trade[]
  watchlists         Watchlist[]
  priceAlerts        PriceAlert[]
  notifications      Notification[]
  chartLayouts       ChartLayout[]
  mt5Accounts    Mt5Account[]
  conversationMembers ConversationMember[]
  messages         Message[]
  posts            Post[]
  followers    Follow[]  @relation("Following")
  following    Follow[]  @relation("Follower")

  @@map("users")
}

enum Role {
  USER
  ADMIN
}

model Session {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  ip        String?
  userAgent String?

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  @@index([userId])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  @@index([userId])
  @@map("password_reset_tokens")
}

model OAuthAccount {
  id                String   @id @default(cuid())
  provider          String
  providerAccountId String
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

// ---------- Phase 2: Trading Journal ----------

model Journal {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime       @default(now())
  groups    JournalGroup[]
  trades    Trade[]

  @@index([userId])
  @@map("journals")
}

model JournalGroup {
  id        String   @id @default(cuid())
  journalId String
  journal   Journal  @relation(fields: [journalId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  trades    Trade[]

  @@index([journalId])
  @@map("journal_groups")
}

enum TradeSide {
  BUY
  SELL
}

enum TradeStatus {
  OPEN
  CLOSED
}

model Trade {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  journalId  String
  journal    Journal       @relation(fields: [journalId], references: [id], onDelete: Cascade)
  groupId    String?
  group      JournalGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  symbol     String
  side       TradeSide
  // Money: Decimal precision everywhere (never float columns)
  entryPrice Decimal       @db.Decimal(20, 8)
  exitPrice  Decimal?      @db.Decimal(20, 8)
  quantity   Decimal       @db.Decimal(20, 8)
  risk       Decimal?      @db.Decimal(20, 8)
  fees       Decimal       @default(0) @db.Decimal(20, 8)
  // pnl computed server-side from stored entry/exit/qty/fees at write time.
  pnl        Decimal?      @db.Decimal(20, 8)
  status     TradeStatus   @default(CLOSED)
  setupTag   String?
  notes      String?
  entryAt    DateTime      @default(now())
  exitAt     DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  attachments Attachment[]

  @@index([userId])
  @@index([journalId])
  @@index([groupId])
  @@index([exitAt])
  @@map("trades")
}

model Attachment {
  id        String   @id @default(cuid())
  tradeId   String
  trade     Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  fileName  String
  mime      String
  size      Int
  path      String // userId/tradeId/random — served only via ownership-checked route
  data      Bytes?   @db.ByteA // image bytes live in Postgres — permanent on Vercel too
  createdAt DateTime @default(now())

  @@index([tradeId])
  @@map("attachments")
}

// ---------- Phase 2: Charts (persistent per-user per-symbol drawings) ----------

model ChartLayout {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope     String   @default("") // e.g. "" (charts page) or "mt5:<accountId>" (trade map)
  symbol    String
  data      Json // drawing tools (trendlines, hlines, vlines) + chart interaction state, captured client-side
  updatedAt DateTime @updatedAt

  @@unique([userId, scope, symbol])
  @@map("chart_layouts")
}

// ---------- Phase 2: Watchlists & Alerts ----------

model Watchlist {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime        @default(now())
  items     WatchlistItem[]

  @@index([userId])
  @@map("watchlists")
}

model WatchlistItem {
  id          String    @id @default(cuid())
  watchlistId String
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  symbol      String
  note        String?
  addedAt     DateTime  @default(now())

  @@unique([watchlistId, symbol])
  @@map("watchlist_items")
}

enum AlertCondition {
  ABOVE
  BELOW
}

model PriceAlert {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol         String
  condition      AlertCondition
  targetPrice    Decimal        @db.Decimal(20, 8)
  note           String?
  active         Boolean        @default(true)
  lastCheckedAt  DateTime?
  triggeredAt    DateTime?
  triggeredPrice Decimal?       @db.Decimal(20, 8)
  createdAt      DateTime       @default(now())

  @@index([userId])
  @@index([active, symbol])
  @@map("price_alerts")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // e.g. "price-alert"
  title     String
  body      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@map("notifications")
}

// ─── Phase 3: MT5 Sync (read-only bridge, no passwords stored server-side) ───

model Mt5Account {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label           String
  login           String // MT5 account number — public metadata, NOT a secret
  server          String
  currency        String   @default("USD")
  // Raw ingest token is shown ONCE at creation; we store only its sha256.
  ingestTokenHash String   @unique
  balance         Decimal? @db.Decimal(20, 2)
  equity          Decimal? @db.Decimal(20, 2)
  lastSyncAt      DateTime?
  // EA self-reports its version on ingest (e.g. "2.00"). Trading from the
  // app only unlocks for EA >= 2.00 — v1 cannot receive trade commands.
  eaVersion       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  positions       Mt5Position[]
  deals           Mt5Deal[]
  quotes          Mt5Quote[]
  commands        Mt5Command[]

  @@index([userId])
  @@map("mt5_accounts")
}

/// Latest bid/ask per symbol, pushed by the terminal EA — the terminal's
/// OWN broker feed, not a third-party approximation.
model Mt5Quote {
  id        String     @id @default(cuid())
  accountId String
  account   Mt5Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  symbol    String
  bid       Decimal    @db.Decimal(20, 8)
  ask       Decimal    @db.Decimal(20, 8)
  tickAt    DateTime? // tick time as reported by the terminal
  updatedAt DateTime   @updatedAt

  @@unique([accountId, symbol])
  @@map("mt5_quotes")
}

/// App-initiated trade orders, executed by the terminal-side EA.
/// The server holds NO MT5 credentials — it can only queue an intent; the
/// EA (which already lives inside the user's terminal) is what executes it.
/// Lifecycle: QUEUED -> (EA claims) TAKEN -> DONE | FAILED (with reason).
model Mt5Command {
  id        String     @id @default(cuid())
  accountId String
  account   Mt5Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  userId    String // who queued it (audit trail)
  symbol    String
  side      TradeSide
  volume    Decimal    @db.Decimal(20, 8)
  status    String     @default("QUEUED") // QUEUED | TAKEN | DONE | FAILED
  ticket    String? // resulting deal ticket on success
  error     String? // broker retcode/reason on failure — never hidden
  createdAt DateTime   @default(now())
  takenAt   DateTime?
  doneAt    DateTime?

  @@index([accountId, status, createdAt])
  @@map("mt5_commands")
}

model Mt5Position {
  id        String     @id @default(cuid())
  accountId String
  account   Mt5Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  ticket    String
  symbol    String
  side      TradeSide
  volume    Decimal    @db.Decimal(20, 8)
  openPrice Decimal    @db.Decimal(20, 8)
  openAt    DateTime
  profit    Decimal?   @db.Decimal(20, 8) // floating P&L as reported by the terminal
  updatedAt DateTime   @updatedAt

  @@unique([accountId, ticket])
  @@map("mt5_positions")
}

model Mt5Deal {
  id              String     @id @default(cuid())
  accountId       String
  account         Mt5Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  ticket          String
  positionId      String // links IN+OUT deals of one round trip
  symbol          String
  side            TradeSide
  entry           String     @default("IN") // IN | OUT | INOUT
  volume          Decimal    @db.Decimal(20, 8)
  price           Decimal    @db.Decimal(20, 8)
  profit          Decimal    @db.Decimal(20, 8)
  commission      Decimal    @default(0) @db.Decimal(20, 8)
  swap            Decimal    @default(0) @db.Decimal(20, 8)
  dealtAt         DateTime
  importedTradeId String?

  @@unique([accountId, ticket])
  @@index([accountId, dealtAt])
  @@map("mt5_deals")
}

// ─── Phase 4: Messenger ───────────────────────────────────────────────────
model Conversation {
  id        String               @id @default(cuid())
  isGroup   Boolean              @default(false)
  name      String?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  members   ConversationMember[]
  messages  Message[]

  @@map("conversations")
}

model ConversationMember {
  conversationId String       @db.VarChar(64)
  userId         String
  lastReadAt     DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String       @db.VarChar(64)
  senderId       String
  text           String       @db.VarChar(4000)
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

// ─── Phase 6: Community (profiles, follows, analysis posts) ────────────────
model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

model Post {
  id         String   @id @default(cuid())
  authorId   String
  text       String   @db.VarChar(4000)
  kind       String   @default("note") // "note" | "analysis"
  visibility String   @default("PUBLIC") // "PUBLIC" | "FOLLOWERS"
  createdAt  DateTime @default(now())
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId, createdAt])
  @@map("posts")
}
